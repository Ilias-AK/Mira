  "font": {
    "family": { "ui": "Inter (вариативный, opsz 14–32)", "mono": "JetBrains Mono / ui-monospace" },
    "scale": {
      "display":  { "size": 40, "lineHeight": 44, "weight": 600, "tracking": "-0.035em", "use": "Приветствие на пустом экране" },
      "heading":  { "size": 20, "lineHeight": 26, "weight": 600, "tracking": "-0.02em", "use": "Заголовки внутри ответа" },
      "answer":   { "size": 16, "lineHeight": 27, "weight": 400, "tracking": "0", "use": "Текст сообщений" },
      "ui":       { "size": 14, "lineHeight": 20, "weight": 500, "tracking": "0", "use": "Кнопки, меню, история" },
      "caption":  { "size": 12, "lineHeight": 16, "weight": 400, "tracking": "0", "use": "Подписи, время ответа, дисклеймер" },
      "code":     { "size": 14, "lineHeight": 24, "weight": 400, "tracking": "0", "use": "Блоки кода" }
    }
  },
  "radius": { "xs": 8, "sm": 10, "md": 12, "lg": 20, "bubble": 22, "composer": 26, "full": 999 },
  "space": [4, 8, 12, 16, 24, 32, 48, 64],
  "size": {
    "sidebar": 272,
    "topbar": 56,
    "column": 720,
    "touchTarget": 44,
    "iconButton": 40,
    "icon": 20,
    "iconStroke": 1.75
  },
  "breakpoint": { "drawer": 860, "phone": 600 },
  "motion": {
    "fast": "150ms ease",
    "message": "320ms cubic-bezier(.2,.8,.2,1)",
    "drawer": "320–360ms cubic-bezier(.32,.72,0,1)"
  }
}
